<?xml version="1.0" encoding="UTF-8"?>
<!--
  Simulierter Standort für Tests: Niederdorf (Altstadt Zürich, rechte
  Limmatseite) – die Gasse, in der die Barrieren am dichtesten liegen.

  Verwendung in Xcode (Simulator UND echtes iPhone):
  1. Datei per Drag & Drop ins Xcode-Projekt ziehen (Target-Membership egal).
  2. App starten, dann in der Debug-Leiste unten das Pfeil-Symbol
     ("Simulate Location") anklicken und "Niederdorf" wählen.
  Oder als Standard: Product > Scheme > Edit Scheme… > Run > Options >
  Core Location > Default Location > Niederdorf.

  Ein einzelner Wegpunkt = fester Standort. Mehrere Wegpunkte (nach Zeit
  aufsteigend sortiert) simuliert Xcode als Fahrt entlang der Punkte.
-->
<gpx version="1.1" creator="Omina" xmlns="http://www.topografix.com/GPX/1/1">
    <wpt lat="47.372" lon="8.543">
        <name>Niederdorf</name>
    </wpt>
</gpx>
