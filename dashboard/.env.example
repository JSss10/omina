# Kopie als .env anlegen und ausfüllen (.env ist in .gitignore).
#
# Beide Werte stehen im Supabase-Dashboard unter Settings → API.
# WICHTIG: hier gehört der "anon public" Key hin, NIE der "service_role" Key –
# alles, was in VITE_* landet, wird in den Browser-Bundle kompiliert und ist
# damit öffentlich. Der Zugriff auf die Feldtestdaten wird nicht über den Key
# geregelt, sondern über Row Level Security (migrations/dashboard_access.sql).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY